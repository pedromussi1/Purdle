# Optional: enables cloud-synced stats via Supabase. Without these, the app
# runs in v1 mode (local stats only, no sign-in UI).
#
# Get the values from your Supabase project dashboard:
#   Settings → API → Project URL  (the URL)
#   Settings → API → Project API keys → anon public  (the long key)
#
# Both values are designed to be public — they're embedded into the client
# bundle. Database access is enforced by Row Level Security policies (see
# supabase/migrations/0001_wordle_stats.sql), not by hiding the key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
